{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "authors.schema.json",
  "title": "Port authors",
  "description": "Maps each author to the list of ports they maintain.",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" }
  },
  "propertyNames": {
    "anyOf": [
      { "const": "$schema" },
      { "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$" }
    ]
  },
  "additionalProperties": {
    "$ref": "#/$defs/author"
  },
  "$defs": {
    "author": {
      "type": "object",
      "properties": {
        "ports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/port" }
        }
      },
      "required": ["ports"],
      "additionalProperties": false
    },
    "port": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the game being ported (e.g. ClassiCube)."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/[A-Za-z0-9-]+/[A-Za-z0-9._-]+/?$",
          "description": "GitHub repository URL of the port."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Optional link text. Defaults to the repository name taken from the URL (e.g. FroggyCraft)."
        }
      },
      "required": ["name", "url"],
      "additionalProperties": false
    }
  }
}
